# jarvis-bootstrap — example environment
#
# Copy to .env and fill in what you have:
#     cp env.example ~/.config/opencode/.env
#     chmod 600 ~/.config/opencode/.env
#
# Everything is optional. With no keys at all you still get the local/free
# lanes plus the filesystem, memory, sqlite and sequential-thinking MCPs.

# --- model providers -------------------------------------------------------
# https://openrouter.ai/keys  (free models available)
OPENROUTER_API_KEY=

# https://aistudio.google.com/apikey  (free tier; powers the `power` agent)
GEMINI_API_KEY=

# https://console.groq.com/keys  (free tier, very fast)
GROQ_API_KEY=

# https://build.nvidia.com  (free credits)
NVIDIA_API_KEY=

# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# --- tooling / MCP ---------------------------------------------------------
# https://magichour.ai  -> Higgsfield image/video MCP
MAGIC_HOUR_API_KEY=

# https://pollinations.ai  (image generation MCP, disabled in config by default)
POLLINATIONS_API_KEY=

# local LiteLLM router — only needed if you run it on localhost:4000
LITELLM_MASTER_KEY=

# https://github.com/settings/tokens  (needs `repo` scope for the github MCP)
GITHUB_MODELS_TOKEN=
